<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_circle"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:letterSpacing="0.08"
            android:text="HALL OF FAME"
            android:textColor="@color/neon_cyan"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Filters: All, Classic, Time Challenge, Coin Rush -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:text="ALL"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFilterClassic"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_btn_outline"
            android:text="CLASSIC"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFilterTime"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_btn_outline"
            android:text="TIME"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFilterCoins"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_btn_outline"
            android:text="COIN RUSH"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp" />

</LinearLayout>
