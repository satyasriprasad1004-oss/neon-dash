<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Glowing Neon Logo Embellishment -->
        <View
            android:id="@+id/logoGlow"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_btn_circle" />

        <TextView
            android:id="@+id/tvLogoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.15"
            android:text="NEON DASH"
            android:textColor="@color/neon_cyan"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogoSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.1"
            android:text="ENDLESS RUNNER ADVENTURE"
            android:textColor="@color/neon_magenta"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="10dp"
            android:layout_marginTop="40dp"
            android:indeterminate="true"
            android:progressDrawable="@drawable/progress_bar_neon" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="INITIALIZING CYBER CORE..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:text="OFFLINE EDITION  •  v1.0"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

</RelativeLayout>
