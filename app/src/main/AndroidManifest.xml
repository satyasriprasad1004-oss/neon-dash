<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeonDash">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Menu -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Gameplay (Portrait mode for fluid vertical handheld runner) -->
        <activity
            android:name=".activities.GameActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.NeonDash.FullScreen" />

        <!-- Sub Screens -->
        <activity
            android:name=".activities.CharacterSelectActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.EnvironmentSelectActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.MissionsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.ShopActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.LeaderboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
